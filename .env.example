# Optional Telegram notifications. Leave blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Camera index: 0 is usually the first USB webcam.
CAMERA_INDEX=0

# Minimum contour area in pixels for a motion event.
MOTION_AREA_THRESHOLD=1800

# Minimum seconds between motion alerts.
ALERT_COOLDOWN_SECONDS=20
